# Copy to .env for local development.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (local development; docker-compose overrides the host to "db")
POSTGRES_USER=pathotrace
POSTGRES_PASSWORD=pathotrace_dev
POSTGRES_DB=pathotrace
DATABASE_URL=postgres://pathotrace:pathotrace_dev@localhost:5432/pathotrace

# Secrets: replace every value below before production.
JWT_SECRET=dev-jwt-secret-change-me-32-characters-minimum
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-characters-minimum
DEVICE_TOKEN_PEPPER=dev-device-pepper-change-me

# Tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Exports
EXPORT_MAX_RANGE_DAYS=31
EXPORT_MAX_ROWS=100000

# Alerts
TEMPERATURE_HIGH_C=39.5

# Logging / Caddy
LOG_LEVEL=info
DOMAIN=localhost
