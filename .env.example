# Copy this file to .env (or .env.local), fill in your backend values, then
# restart Metro with cache cleared: npx expo start -c
#
# Leave EXPO_PUBLIC_API_URL empty to run the built-in demonstration mode.
# Every EXPO_PUBLIC_* value is embedded in the client bundle at build time.
# Never put secrets (API keys, database passwords) in these variables.

# Base URL of the PathoTrace API, without a trailing slash.
EXPO_PUBLIC_API_URL=

# Authentication
EXPO_PUBLIC_AUTH_LOGIN_PATH=/auth/login
EXPO_PUBLIC_AUTH_LOGOUT_PATH=/auth/logout
EXPO_PUBLIC_FORGOT_PASSWORD_PATH=/auth/forgot-password

# Core resources
EXPO_PUBLIC_CATTLE_PATH=/cattle
EXPO_PUBLIC_ASSESSMENTS_PATH=/assessments
EXPO_PUBLIC_ALERTS_PATH=/alerts
EXPO_PUBLIC_HEALTH_RECORDS_PATH=/health-records
EXPO_PUBLIC_OBSERVATIONS_PATH=/observations
